generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Hospitales {
  Id             Int                 @id @default(autoincrement())
  Nombre         String              @db.NVarChar(100)
  Codigo         String              @unique @db.NVarChar(20)
  LimiteAlmuerzo String              @default("09:00") @db.NVarChar(10)
  LimiteCena     String              @default("17:00") @db.NVarChar(10)
  Servicios      Servicios[]
  Personal       Personal[]
  Usuarios       Usuarios[]
  Padron         PadronHabilitados[]
}

model Servicios {
  Id                Int                 @id @default(autoincrement())
  HospitalId        Int
  Nombre            String              @db.NVarChar(100)
  VoucherIndividual Boolean             @default(false)
  Hospital          Hospitales          @relation(fields: [HospitalId], references: [Id])
  Personal          Personal[]
  Usuarios          Usuarios[]
  Padron            PadronHabilitados[]

  @@unique([HospitalId, Nombre])
}

model Personal {
  Id                      Int             @id @default(autoincrement())
  DNI                     String          @unique @db.NVarChar(20)
  NombreCompleto          String          @db.NVarChar(200)
  HospitalId              Int
  ServicioId              Int
  IdPersonal              String?         @db.NVarChar(50)
  Horario                 String          @db.NVarChar(50)
  PeriodoInicio           DateTime        @db.Date
  PeriodoFin              DateTime        @db.Date
  Activo                  Boolean         @default(true)
  BajaProvisoriaFecha     DateTime?       @db.Date
  BajaProvisoriaHasta     DateTime?       @db.Date
  BajaMotivo              String?         @db.NVarChar(50)
  IdPuesto                String?         @db.NVarChar(50)
  TipoFuncion             String?         @db.NVarChar(100)
  TipoPlanta              String?         @db.NVarChar(100)
  ConVianda               Boolean         @default(false)
  EsGuardia12             Boolean         @default(false)
  EsGuardia24             Boolean         @default(false)
  Hospital                Hospitales      @relation(fields: [HospitalId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Servicio                Servicios       @relation(fields: [ServicioId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  PedidosComida           PedidosComida[] @relation("PedidosPersonales")
  EmergenciasReemplazadas PedidosComida[] @relation("Reemplazos")
}

model Roles {
  Id       Int        @id
  Nombre   String     @db.NVarChar(50)
  Usuarios Usuarios[]
}

model Usuarios {
  Id                    Int             @id @default(autoincrement())
  NombreUsuario         String          @unique @db.NVarChar(50)
  NombreCompleto        String?         @db.NVarChar(200)
  ContrasenaHash        String          @db.NVarChar(255)
  RolId                 Int
  HospitalId            Int?
  ServicioId            Int?
  TwoFactorSecret       String?         @db.NVarChar(128)
  TwoFactorHabilitado   Boolean         @default(false)
  Activo                Boolean         @default(true)
  DebeCambiarContrasena Boolean         @default(false)
  Rol                   Roles           @relation(fields: [RolId], references: [Id])
  Hospital              Hospitales?     @relation(fields: [HospitalId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Servicio              Servicios?      @relation(fields: [ServicioId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  PedidosSolicitados    PedidosComida[] @relation("PedidosSolicitados")
  PedidosEvaluados      PedidosComida[] @relation("PedidosEvaluados")
  Auditorias            Auditoria[]
}

model PedidosComida {
  Id                       Int       @id @default(autoincrement())
  FechaPedido              DateTime  @db.Date
  FechaCreacion            DateTime  @default(now())
  TipoComida               String    @db.NVarChar(20)
  TipoDieta                String    @default("Normal") @db.NVarChar(30)
  PersonalId               Int?
  SolicitadoPorUsuarioId   Int
  Estado                   String    @default("Aprobado") @db.NVarChar(20)
  EmergenciaNombreCompleto String?   @db.NVarChar(200)
  EmergenciaDNI            String?   @db.NVarChar(20)
  EmergenciaPeriodoInicio  DateTime? @db.Date
  EmergenciaPeriodoFin     DateTime? @db.Date
  EmergenciaReemplazaId    Int?
  JustificacionSolicitud   String?   @db.NVarChar(500)
  JustificacionResolucion  String?   @db.NVarChar(500)
  EvaluadoPorUsuarioId     Int?
  Personal                 Personal? @relation("PedidosPersonales", fields: [PersonalId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  PersonalReemplazado      Personal? @relation("Reemplazos", fields: [EmergenciaReemplazaId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  SolicitadoPor            Usuarios  @relation("PedidosSolicitados", fields: [SolicitadoPorUsuarioId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  EvaluadoPor              Usuarios? @relation("PedidosEvaluados", fields: [EvaluadoPorUsuarioId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
}

model PadronHabilitados {
  Id             Int         @id @default(autoincrement())
  DNI            String      @unique @db.NVarChar(20)
  NombreCompleto String      @db.NVarChar(200)
  EsGuardia24h   Boolean     @default(false)
  Activo         Boolean     @default(true)
  FechaCreacion  DateTime    @default(now())
  HospitalId     Int?
  ServicioId     Int?
  Hospital       Hospitales? @relation(fields: [HospitalId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Servicio       Servicios?  @relation(fields: [ServicioId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
}

model Auditoria {
  Id        Int       @id @default(autoincrement())
  Fecha     DateTime  @default(now())
  UsuarioId Int?
  Accion    String    @db.NVarChar(100)
  Detalles  String?   @db.NVarChar(1000)
  IpAddress String?   @db.NVarChar(50)
  Usuario   Usuarios? @relation(fields: [UsuarioId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
}
